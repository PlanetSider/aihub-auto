# Image tag published to GitHub Container Registry.
AIHUB_AUTO_IMAGE_TAG=latest

# Keep the service local by default. Set to 0.0.0.0 only behind trusted TLS/auth.
AIHUB_AUTO_BIND=127.0.0.1
AIHUB_AUTO_PUBLISHED_PORT=8787

# Required for non-loopback container listening. Use long random values.
AIHUB_AUTO_PROXY_TOKEN=replace-with-at-least-16-characters
AIHUB_AUTO_UI_PASSWORD=replace-with-at-least-12-characters
