  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "license": "MIT",
  "keywords": ["chatbot", "koishi", "plugin", "onebot", "aihub", "ai"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WSXYT/aihub-auto.git",
    "directory": "packages/koishi-plugin-aihub-auto"
  },
  "homepage": "https://github.com/WSXYT/aihub-auto",
  "koishi": {
    "description": {
      "zh": "查询 AIHub 当前最优分组,或最高倍率且最慢的单个最烂分组",
      "en": "Query current best or worst AIHub groups"
