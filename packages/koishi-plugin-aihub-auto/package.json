  },
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test"
  },
  "peerDependencies": {
    "koishi": "^4.17.0"
  },
  "devDependencies": {
    "@aihub-auto/core": "workspace:*",
    "@koishijs/plugin-http": "^0.6.3",
    "@koishijs/plugin-mock": "^2.6.6",
    "koishi": "^4.17.0"
  }
